# ============================================================
# Backend Environment Variables — EXAMPLE / TEMPLATE
# Copy this file to .env and fill in your real values.
# !! Never commit .env to version control !!
# ============================================================

PORT=5000

# PRINTER_TYPE: EPSON | STAR
PRINTER_TYPE=EPSON

# PRINTER_INTERFACE examples:
#   Network:  tcp://192.168.1.100
#   Serial:   /dev/ttyUSB0
#   Windows:  COM3
#   Driver:   printer:My_Printer_Name
PRINTER_INTERFACE=tcp://192.168.1.100

PRINTER_WIDTH=80mm
PRINTER_CHARACTER_SET=PC437_USA

CORS_ORIGIN=http://localhost:5173
